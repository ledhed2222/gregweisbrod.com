{
  "name": "gregweisbrod.com",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@ledhed2222/eslint-config": "^1.1.0",
    "@ledhed2222/htmlhint-config": "^1.0.1",
    "@ledhed2222/prettier-config": "^1.1.0",
    "@ledhed2222/stylelint-config": "^1.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.6",
    "react-router-dom": "^7.18.4",
    "react-transition-group": "^4.4.5"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "htmlhint": "htmlhint-config-lint . --ignore build",
    "test": "playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "prepare": "husky"
  },
  "prettier": "@ledhed2222/prettier-config",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md}": "prettier --write",
    "*.html": [
      "htmlhint-config-lint",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.22.1",
    "npm": ">=8.0.0"
  }
}
