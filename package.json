{
  "name": "gregweisbrod.com",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.2",
    "@ledhed2222/eslint-config": "^2.0.0",
    "@ledhed2222/htmlhint-config": "^1.1.0",
    "@ledhed2222/prettier-config": "^1.1.0",
    "@ledhed2222/stylelint-config": "^1.0.2",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "react-transition-group": "^4.4.5"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "htmlhint": "htmlhint-config-lint index.html",
    "test": "playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "prepare": "husky"
  },
  "prettier": "@ledhed2222/prettier-config",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md}": "prettier --write",
    "*.html": [
      "htmlhint-config-lint",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24",
    "npm": ">=8.0.0"
  }
}
